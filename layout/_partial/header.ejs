<nav>
    <a href="<%= url_for('/') %>" class="logo"><%= theme.site.title || config.title %></a>
    <div class="menu">
        <% theme.menu.forEach(function(item) { %>
            <a href="<%= url_for(item.url) %>"><%= item.name %></a>
        <% }); %>
        <button class="search-btn" id="search-btn" aria-label="搜索">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </button>
    </div>
</nav>

<!-- 搜索模态框 -->
<div class="search-modal" id="search-modal">
    <div class="search-overlay" id="search-overlay"></div>
    <div class="search-container">
        <div class="search-header">
            <input type="text" id="search-input" placeholder="搜索文章..." class="search-input">
            <button class="search-close" id="search-close" aria-label="关闭">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="search-results" id="search-results">
            <div class="search-loading" id="search-loading">正在搜索...</div>
            <div class="search-empty" id="search-empty" style="display: none;">
                输入关键词开始搜索
            </div>
        </div>
    </div>
</div>
