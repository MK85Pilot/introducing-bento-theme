<footer>
    <div class="footer-col">
        <h4>Social</h4>
        <div class="footer-links">
            <% theme.footer.social.forEach(function(link) { %>
                <a href="<%= link.url %>"><%= link.name %></a>
            <% }); %>
        </div>
    </div>
    <div class="footer-col">
        <h4>Contact</h4>
        <div class="footer-links">
            <% theme.footer.contact.forEach(function(link) { %>
                <a href="<%= link.url %>"><%= link.name %></a>
            <% }); %>
        </div>
    </div>
    <div class="footer-col" style="text-align: right; color: var(--text-muted); font-size: 0.85rem;">
        <p><%- theme.footer.copyright %></p>
        <p><%= theme.footer.tagline %></p>
    </div>
</footer>