<section>
    <span class="section-title">Journal</span>
    <div class="post-list">
        <% page.posts.each(function(post) { %>
            <article class="post-item">
                <div class="post-date"><%= date(post.date, 'MMM DD, YYYY') %></div>
                <div class="post-content">
                    <h3 class="post-title">
                        <a href="<%= url_for(post.path) %>" style="text-decoration: none; color: inherit;">
                            <%= post.title %>
                        </a>
                    </h3>
                    <% if (post.excerpt) { %>
                        <p class="post-excerpt"><%= post.excerpt %></p>
                    <% } %>
                </div>
                <div class="arrow-icon">→</div>
            </article>
        <% }); %>
    </div>
    
    <% if (page.total > 1) { %>
        <%- paginator() %>
    <% } %>
</section>